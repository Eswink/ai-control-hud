<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080B10"
    android:padding="18dp">

    <LinearLayout
        android:id="@+id/setupPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AI CONTROL HUD"
            android:textColor="#F1F3F4"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Backend server"
            android:textColor="#9AA0A6"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/serverUrlInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:hint="192.168.1.50:8787"
            android:inputType="textUri"
            android:singleLine="true"
            android:textColor="#F1F3F4"
            android:textColorHint="#5F6368" />

        <Button
            android:id="@+id/connectButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="CONNECT" />

        <TextView
            android:id="@+id/setupStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:textColor="#F28B82"
            android:textSize="13sp" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/dashboardPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="AI CONTROL"
                    android:textColor="#F1F3F4"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/liveStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CONNECTING"
                    android:textColor="#FDD663"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/serverLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="middle"
                android:maxLines="1"
                android:textColor="#5F6368"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/lastUpdateText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Waiting for first snapshot"
                android:textColor="#5F6368"
                android:textSize="11sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="14dp"
                android:background="#27313D" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="ZCODE"
                android:textColor="#9AA0A6"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/zcodeHealth"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:maxLines="2"
                android:text="--"
                android:textColor="#9AA0A6"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/zcodeSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="--"
                android:textColor="#F1F3F4"
                android:textSize="20sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/taskList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/taskEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Task data unavailable"
                android:textColor="#9AA0A6"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/taskOverflow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="end"
                android:textColor="#8AB4F8"
                android:textSize="12sp"
                android:visibility="gone" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="18dp"
                android:background="#27313D" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="COMMAND CODE"
                android:textColor="#9AA0A6"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/commandHealth"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:maxLines="2"
                android:text="--"
                android:textColor="#9AA0A6"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/planText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Plan --"
                android:textColor="#F1F3F4"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/creditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Credit --"
                android:textColor="#F1F3F4"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/fiveHourLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="5H --"
                android:textColor="#BDC1C6"
                android:textSize="13sp" />

            <ProgressBar
                android:id="@+id/fiveHourProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="5dp"
                android:max="100"
                android:progress="0"
                android:progressTint="#8AB4F8" />

            <TextView
                android:id="@+id/weeklyLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                android:text="WEEK --"
                android:textColor="#BDC1C6"
                android:textSize="13sp" />

            <ProgressBar
                android:id="@+id/weeklyProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="5dp"
                android:max="100"
                android:progress="0"
                android:progressTint="#8AB4F8" />

            <Button
                android:id="@+id/changeServerButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="24dp"
                android:text="SERVER" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
